# Public site URL (used for referral links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. When unset, the waitlist uses a local file store at apps/web/.data/ (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing signup IPs (fraud checks). Any long random string.
IP_HASH_SALT=change-me

# Postgres via the Supabase session pooler (IPv4). Used by migrations and the worker.
DATABASE_URL=
# Browser auth (Supabase dashboard > Project Settings > API > anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AES-256-GCM key for OAuth tokens (64 hex chars). Never change once tokens are stored.
TOKEN_ENCRYPTION_KEY=
# Claude API (brand brain, drafts, replies, QA). Without it, AI runs on a labelled mock.
ANTHROPIC_API_KEY=
# Email (Resend). Without it, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=ShipItLoud <onboarding@resend.dev>
# live = real platform calls; anything else = test mode (no real posts or spend)
ACTIONS_MODE=test
# Hard monthly cap on Anthropic spend for this app (USD). Calls stop when reached.
AI_MONTHLY_BUDGET_USD=1
# Model overrides. PRD: Haiku for drafts, a Sonnet for brand brain/long-form. Both default to Haiku 4.5.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_SMART=claude-haiku-4-5
# AI_MODE=mock makes every AI call return labelled sample output (no spend). Used in tests.
AI_MODE=
